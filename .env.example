# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; this file is not -- never put real secrets in this one.

# Generated by running `npx auth secret` (writes directly into .env.local).
AUTH_SECRET=

# Vercel dashboard -> your project -> Storage -> Postgres -> connection string.
DATABASE_URL=

# Resend dashboard -> API Keys (create one with "Sending access").
AUTH_RESEND_KEY=

# Sender address for magic-link emails. onboarding@resend.dev works but only
# delivers to your own Resend account email until you verify a custom sending
# domain in the Resend dashboard.
AUTH_EMAIL_FROM=onboarding@resend.dev
